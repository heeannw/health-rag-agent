# 프로젝트 전체 공용 환경변수

# ── data.go.kr (공공데이터포털) ─────────────────────────────
# 계정 공통 일반 인증키 (URL-encoded 형태 그대로 붙여넣기)
# data-rag 수집기, agent/backend/scripts/collect_facilities.py에서 사용
DATA_GO_KR_API_KEY=
# health_benefits 수집 스크립트(collection/)에서 사용. 보통 위와 같은 키
DATA_GO_KR_SERVICE_KEY=

# ── Gemini (data-rag) ──────────────────────────────────────
# aistudio.google.com/apikey 에서 발급 — LLM 답변 생성용
GEMINI_API_KEY=

# ── Kakao (agent) ──────────────────────────────────────────
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
# scripts/collect_facilities.py가 기관 주소를 좌표로 바꿀 때 사용
KAKAO_REST_API_KEY=
# 앱 키 > JavaScript 키 (프론트 지도). 플랫폼 > Web 사이트 도메인에 http://localhost:5173 등록 필요
# VITE_ 로 시작하는 키만 브라우저에 노출된다. 다른 비밀 키에 VITE_ 를 붙이지 말 것
VITE_KAKAO_MAP_KEY=

# ── Supabase Postgres (health_benefits) ────────────────────
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PGCONNECT_TIMEOUT=10
